{
  "name": "rick-and-morty",
  "type": "module",
  "private": true,
  "description": "A server-side rendered character explorer built with Nuxt 4 and the Rick and Morty API.",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "nuxt": "^4.6.4",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.11.0",
    "@tailwindcss/vite": "^4.1.17",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.3",
    "dotenv": "^18.0.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.11.0 <25"
  }
}
